{
  "manifest_version": 3,
  "name": "Referral Assistant",
  "version": "1.0.0",
  "description": "Find people at a target company, draft referral requests and track follow-ups. You send every message yourself.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "contextMenus", "alarms", "notifications", "scripting"],
  "optional_host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Referral Assistant", "default_icon": "icon.png" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "128": "icon.png" }
}
